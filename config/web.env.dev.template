# ocpctl web frontend configuration (dev)
#
# Copy to config/web.env.dev — deploy-web.sh installs it at /etc/ocpctl/web.env,
# which is the EnvironmentFile for deploy/systemd/ocpctl-web.service.
#
# Nothing here is secret; the NEXT_PUBLIC_* values are compiled into the browser
# bundle. NEXT_PUBLIC_API_URL is a relative path on purpose so the frontend calls
# back through the same nginx vhost it was served from (nginx proxies /api/ to
# the Go API on :8080) — no CORS, and no hardcoded hostname to update on rebuild.

NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_AUTH_MODE=jwt
NEXT_PUBLIC_AWS_REGION=us-east-1
NEXT_PUBLIC_APP_ENV=dev
NODE_ENV=production
PORT=3000
